# Copy to .env and adjust as needed.
DATABASE_URL=postgresql+psycopg://localhost:5432/dynasty_football
# JSON list of the web app's origins (browsers' changes from anywhere else are refused).
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SEED=2026
# Deployed environments also set ENVIRONMENT, LOG_FORMAT=json, COOKIE_SECURE=true,
# SITE_URL, SENTRY_DSN and SMTP_* (see render.yaml and docs/deploy.md). Locally,
# password reset emails are logged instead of sent.
# The local account `make seed` / `make reseed` gives the sample league to (sign in with it).
DEV_USER_EMAIL=dev@example.test
DEV_USER_PASSWORD=dynasty-local-dev

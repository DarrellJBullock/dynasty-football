{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd backend && WORKER_EMBEDDED=1 .venv/bin/uvicorn app.main:app --reload --port 8000"
      ],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "e2e-backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd backend && DATABASE_URL=postgresql+psycopg://localhost:5432/dynasty_football_e2e CORS_ORIGINS='[\"http://localhost:3001\"]' WORKER_EMBEDDED=1 .venv/bin/uvicorn app.main:app --port 8001"
      ],
      "port": 8001
    },
    {
      "name": "e2e-frontend",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd frontend && NEXT_DIST_DIR=.next-e2e API_URL=http://localhost:8001 NEXT_PUBLIC_API_URL=http://localhost:8001 npx next start --port 3001"
      ],
      "port": 3001
    }
  ]
}
